# Copy to .env and fill in. .env never goes to GitHub (it's in .gitignore): copy it to each device.

# Login passcode (at least 4 characters). Wrong tries lock login with doubling waits.
PASSCODE=

# GitHub fine-grained token: repository bagrikashish13/GateBrain only, "Contents: Read and write".
# The app pulls and pushes the repo with it, so a fresh clone needs no SSH key or git login.
# Empty = use whatever git credentials this machine already has.
GITHUB_TOKEN=

# Day boundary for "today", the plan and revision.
TZ=Asia/Kolkata

# --- VM only (docker compose) ---
# Host port the app listens on (bound to 127.0.0.1; the Cloudflare tunnel points at it).
GATEBRAIN_PORT=3200
# Public hostname behind the tunnel, e.g. gate.example.com (lets Server Actions accept it).
PUBLIC_HOST=
# uid/gid that owns the clone on the VM, so the app's commits keep the files yours.
HOST_UID=1000
HOST_GID=1000
# VM only: COMPOSE_PROFILES=vm starts the tunnel; its token from Cloudflare Zero Trust → Tunnels.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
